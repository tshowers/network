{
  "name": "network",
  "version": "2026.9.24-build.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/update-build-version.mjs",
    "build": "ng build",
    "postbuild": "cp dist/network/browser/index.csr.html dist/network/browser/index.html",
    "deploy:hosting": "./deploy.sh",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "typecheck:cypress": "tsc -p tsconfig.cypress.json --noEmit --pretty false",
    "emulators:start": "firebase emulators:start --project taliferrotech --only auth,firestore",
    "e2e:app": "start-server-and-test start http://localhost:4200 cy:run",
    "e2e": "firebase emulators:exec --project taliferrotech --only auth,firestore \"npm run e2e:app\"",
    "serve:ssr:network": "node dist/network/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@angular/service-worker": "^19.2.25",
    "@angular/ssr": "^19.2.27",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@taliferro/ui": "file:../../taliferro-ui",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "express": "^4.18.2",
    "firebase": "^12.18.0",
    "papaparse": "^5.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.4",
    "@angular/cli": "^19.0.4",
    "@angular/compiler-cli": "^19.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/papaparse": "^5.5.2",
    "cypress": "^13.17.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.6.2"
  }
}
